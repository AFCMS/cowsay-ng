{
  "name": "@afcms/cowsay-ng",
  "version": "0.0.1",
  "description": "Next-gen cowsay",
  "keywords": [
    "ascii-art",
    "cowsay",
    "fun",
    "terminal"
  ],
  "homepage": "https://github.com/AFCMS/cowsay-ng#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/cowsay-ng/issues"
  },
  "license": "MIT AND GPL-3.0-only",
  "author": "AFCMS <afcm.contact@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/cowsay-ng.git"
  },
  "bin": {
    "cowsay-ng": "./dist/bin/cowsay.mjs",
    "cowthink-ng": "./dist/bin/cowthink.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bin/*.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./cows/*.cow": {
      "types": "./dist/raw-cow.d.ts",
      "import": "./dist/share/cowsay/cows/*.cow"
    },
    "./cows/*": {
      "types": "./dist/cows/*.d.mts",
      "import": "./dist/cows/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node --experimental-import-text ./dist/bin/cowsay.mjs",
    "cows:download": "node scripts/download-cows.ts",
    "cows:generate": "node scripts/generate-cows.ts",
    "unicode:generate": "node scripts/generate-unicode.ts",
    "fixtures:generate": "node scripts/generate-fixtures.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.ts",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "dependencies": {
    "cac": "^7.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@oxc-node/core": "^1.0.1",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26"
  }
}
