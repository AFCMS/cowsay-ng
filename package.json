{
  "name": "@afcms/cowsay-ng",
  "version": "0.0.1",
  "description": "Next-gen cowsay",
  "keywords": [
    "ascii-art",
    "cowsay",
    "fun",
    "terminal"
  ],
  "homepage": "https://github.com/AFCMS/cowsay-ng#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/cowsay-ng/issues"
  },
  "license": "MIT",
  "author": "AFCMS <afcm.contact@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/cowsay-ng.git"
  },
  "bin": {
    "cowsay-ng": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26"
  }
}
